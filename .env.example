APP_NAME="听书后台"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.mixyj.cn
APP_TIMEZONE=Asia/Shanghai

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listen_book
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 微信小程序：AppID 已填，AppSecret 在 mp.weixin.qq.com → 开发管理 → 开发设置 生成，仅存服务端
WX_APPID=wxd1742cec14ff6355
WX_SECRET=

# 管理后台登录密码（session 认证，无数据库管理员表）
ADMIN_PASSWORD=

# 腾讯云 COS（S3 兼容协议）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-1250000000
COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
COS_CDN_DOMAIN=https://cos.mixyj.cn
# 上传报 403 / 域名异常时改为 true（可选）
COS_USE_PATH_STYLE=false

# 小程序首页公告，留空不显示
MINIAPP_ANNOUNCEMENT=
