APP_NAME="听书后台"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.mixyj.cn
APP_TIMEZONE=Asia/Shanghai

# 品牌：后台站名 / Logo / 主色。换项目只改这三项（视图统一读 $brand，不再写死文案与色值）。
#   BRAND_NAME  留空则回退上面的 APP_NAME
#   BRAND_LOGO  留空只显示站名文字；可填站内相对路径（/storage/brand/logo.png）或完整 URL
#   BRAND_COLOR 主色，作用于按钮 / 链接 / 选中态
BRAND_NAME=
BRAND_LOGO=
BRAND_COLOR="#185fa5"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listen_book
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 微信小程序：AppID 已填，AppSecret 在 mp.weixin.qq.com → 开发管理 → 开发设置 生成，仅存服务端
WX_APPID=wxd1742cec14ff6355
WX_SECRET=

# 管理后台登录密码（session 认证，无数据库管理员表）
ADMIN_PASSWORD=

# 存储：腾讯云标准 COS，本工程使用 bucket 默认访问域名（不配自定义域名/CDN）。
# 标准 COS 支持自定义源站域名 / CDN 加速；日后要启用只需改 COS_CDN_DOMAIN，
# 音频与封面 URL 都由它动态生成，换桶 / 换域名都不用刷数据库。
# AUDIO_DRIVER=s3 走 S3 兼容接口；=local 走「一键挂载到服务器目录」，业务代码不用改。
AUDIO_DRIVER=s3
AUDIO_LOCAL_ROOT=/mnt/lightcos

# 注意：以下两项必填。留空时上传会报
# "Error retrieving credentials from the instance profile metadata service"（cURL error 28），
# 因为 AWS SDK 会回退去 169.254.169.254 找实例凭证。排错见 README 第 3 节。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
# ↓ 占位值，必须改成控制台里的真实桶名（含 AppId 后缀）
COS_BUCKET=your-bucket-1250000000
COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# 音频与封面的对外访问根地址（不带路径、不带结尾斜杠），同时是小程序 downloadFile 合法域名
#  路径 A（s3）：填 bucket 默认访问域名 https://<bucket>.cos.<region>.myqcloud.com
#  路径 B（local）：填自有已备案域名 https://cos.mixyj.cn（nginx 指向 AUDIO_LOCAL_ROOT）
# ↓ 占位值，必须和 COS_BUCKET 一起改成真实桶名 / 访问域名
COS_CDN_DOMAIN=https://your-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
# 上传报 403 / 域名异常时改为 true（可选）
COS_USE_PATH_STYLE=false

# 小程序首页公告，留空不显示
MINIAPP_ANNOUNCEMENT=
